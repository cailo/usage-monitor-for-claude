[Desktop Entry]
Type=Application
Name=Usage Monitor for Claude
Comment=Claude usage quotas in the system tray
Comment[es]=Cuotas de uso de Claude en la bandeja del sistema
Exec=/usr/bin/usage-monitor-for-claude-daemon
Icon=usage-monitor-for-claude
Categories=Utility;Monitor;
Terminal=false
# The panel widget is the user interface; this entry exists so notifications
# can resolve the application icon through their desktop-entry hint.
NoDisplay=true
X-GNOME-UsesNotifications=true
