#!/bin/sh
# Launcher for the Usage Monitor daemon.
#
# The application is installed as a source tree rather than a wheel because
# i18n.py resolves the translations relative to the package directory
# (../locale).  Keeping the original layout means the locale lookup, and the
# audit trail of the upstream Windows build, stay byte-for-byte identical.
PYTHONPATH=/usr/share/usage-monitor-for-claude${PYTHONPATH:+:$PYTHONPATH}
export PYTHONPATH
exec /usr/bin/python -m usage_monitor_linux "$@"
